.icon-label {
    flex-direction: row;
    align-items: center;
    width: 461px;
    height: auto;
    translate: 93px 0;
}

.icon-label__icon {
    width: 45px;
    height: 45px;
    margin-right: var(--spacing-xs);
    -unity-background-scale-mode: scale-to-fit;
    background-image: none;
}

.icon-label__text {
    color: var(--color-text);
    font-size: 30px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

.icon-label--pill {
    background-color: var(--color-panel);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 20px;
    padding: 2px var(--spacing-s) 2px 2px;
}

.icon-label--pill .icon-label__icon {
    border-radius: 13px;
    background-color: var(--color-panel-alt);
    border-width: 1px;
    border-color: var(--color-border-light);
}

.icon-gold {
    background-color: rgba(214, 161, 61, 0);
    border-radius: 13px;
    background-image: url("project://database/Assets/Project/Arts/UI/gold_icon.png?fileID=2800000&guid=5da2d1ab537067e468bfa8f72686ccfa&type=3#gold_icon");
}

.icon-gem {
    background-color: rgba(77, 214, 138, 0);
    border-radius: 4px;
    background-image: url("project://database/Assets/Project/Arts/UI/gem_icon.png?fileID=2800000&guid=f6a7b7bc88eab5e47b548ceae3c8c48f&type=3#gem_icon");
}

.icon-level {
    background-color: rgba(180, 99, 224, 0);
    border-radius: 13px;
    background-image: url("project://database/Assets/Project/Arts/UI/level_icon.png?fileID=2800000&guid=f9aa8446fc08aff45817c02c81dbf190&type=3#level_icon");
}
