.item-slot {
    width: 96px;
    height: 96px;
    background-color: var(--color-panel-alt);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-s);
    margin: var(--spacing-xs);
    align-items: center;
    justify-content: center;
    position: relative;
}

.item-slot:hover {
    border-color: var(--color-accent);
}

.item-slot__icon {
    width: 72px;
    height: 72px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-slot__type-label {
    color: var(--color-text-dim);
    font-size: var(--font-size-small);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
}

.item-slot__quantity {
    position: absolute;
    right: 4px;
    bottom: 2px;
    color: var(--color-text);
    font-size: var(--font-size-small);
    -unity-font-style: bold;
}

.item-slot__equipped-badge {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background-color: var(--color-accent);
    border-radius: 7px;
}

/* Vien mau theo do hiem - gan class nay qua SetRarity() */
.item-slot--rarity-common { border-color: var(--color-rarity-common); }
.item-slot--rarity-rare { border-color: var(--color-rarity-rare); }
.item-slot--rarity-epic { border-color: var(--color-rarity-epic); }
.item-slot--rarity-legendary { border-color: var(--color-rarity-legendary); }
