    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384572
    m_Localized: No free socket on your equipped weapons.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384573
    m_Localized: This socket unlocks at weapon level {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384574
    m_Localized: Choose a rune from the bag (Esc to cancel).
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384575
    m_Localized: Socket selection cancelled.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384576
    m_Localized: Click again to remove this rune (costs {0} Gem).
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384577
    m_Localized: Rune socketed.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384578
    m_Localized: Rune removed.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384579
    m_Localized: Not enough Gem.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384580
    m_Localized: The rune bag is full.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384581
    m_Localized: This socket is locked.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384582
    m_Localized: This socket already has a rune.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384583
    m_Localized: That rune is no longer in the bag.
    m_Metadata:
      m_Items: []
  - m_Id: 22304924808384584
    m_Localized: Cannot do that.
    m_Metadata:
      m_Items: []
  - m_Id: 22337453435260928
    m_Localized: "\u0110\u0103ng nh\u1EADp th\u1EA5t b\u1EA1i. Vui l\xF2ng ki\u1EC3m
      tra l\u1EA1i t\xE0i kho\u1EA3n ho\u1EB7c k\u1EBFt n\u1ED1i m\u1EA1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 22337513053097984
    m_Localized: "Kh\xF4ng th\u1EC3 k\u1EBFt n\u1ED1i t\u1EDBi m\xE1y ch\u1EE7 \u0111\xE1m
      m\xE2y. \u0110ang t\u1EA3i d\u1EEF li\u1EC7u d\u1EF1 ph\xF2ng c\u1EE5c b\u1ED9."
    m_Metadata:
      m_Items: []
  - m_Id: 22348295560105984
    m_Localized: "M\u1EA5t k\u1EBFt n\u1ED1i m\xE1y ch\u1EE7! Ti\u1EBFn tr\xECnh
      c\u1EE7a b\u1EA1n \u0111\xE3 \u0111\u01B0\u1EE3c t\u1EA1m l\u01B0u c\u1EE5c
      b\u1ED9 tr\xEAn thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 22348566184988672
    m_Localized: "L\u1ED7i l\u01B0u tr\u1EEF! Kh\xF4ng th\u1EC3 ghi d\u1EEF li\u1EC7u
      l\u01B0u game v\xE0o b\u1ED9 nh\u1EDB thi\u1EBFt b\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 22364712707690496
    m_Localized: "T\u1EF1 \u0111\u1ED9ng l\u01B0u th\xE0nh c\xF4ng."
    m_Metadata:
      m_Items: []
